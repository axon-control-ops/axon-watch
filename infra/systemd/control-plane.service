[Unit]
Description=Axon-X Control Plane
After=network.target axon-watch.service
Wants=network-online.target
Requires=axon-watch.service

[Service]
Type=simple
EnvironmentFile=/etc/axon-watch/deployment.env
WorkingDirectory=/opt/axon-watch
ExecStart=/opt/axon-watch/scripts/ops/run-service.sh control-plane
Restart=on-failure
RestartSec=3
TimeoutStopSec=12
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
