[Unit]
Description=Axon-X Console Web :4173 (user always-on)
After=network.target control-plane.service
Wants=network-online.target control-plane.service
# Wants (not Requires): a control-plane bounce must not take :4173 down with it.
# Requires= caused Vite :5173 proxy spam + a stuck IDE whenever CP restarted.

[Service]
Type=simple
EnvironmentFile=%h/.config/axon-watch/deployment.env
WorkingDirectory=%h
ExecStartPre=/bin/bash -lc 'cd "%h/axon-nvme/repos/axon-watch" && test -d apps/console-web/dist || npm run build -w @axon-watch/console-web'
ExecStart=%h/axon-nvme/repos/axon-watch/scripts/ops/run-service.sh console-web
Restart=always
RestartSec=3
MemoryAccounting=yes
MemoryHigh=512M
MemoryMax=1G
OOMPolicy=continue

[Install]
WantedBy=default.target
