[Unit]
Description=Axon-X Control Plane (user always-on)
After=network.target axon-watch.service
Wants=network-online.target
Requires=axon-watch.service

[Service]
Type=simple
EnvironmentFile=%h/.config/axon-watch/deployment.env
WorkingDirectory=%h
ExecStart=%h/axon-nvme/repos/axon-watch/scripts/ops/run-service.sh control-plane
Restart=on-failure
RestartSec=3
# Speak / live-event connections used to block graceful stop for ~90s (default
# TimeoutStopSec), leaving :8787 dead and Vite logging ECONNREFUSED. Cap stop
# so restarts reclaim the port quickly; uvicorn also gets --timeout-graceful-shutdown.
TimeoutStopSec=12
KillMode=mixed
KillSignal=SIGTERM
# Do not death-spiral: systemd-oomd / OOMPolicy stop with SIGKILL must stay down
# until an operator restarts the unit intentionally.
RestartPreventExitStatus=SIGKILL
# Hard cap — a prior peak of ~10.5G froze the desktop (OOM / VT kill).
# Prefer killing the CP unit over taking down the whole machine.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=5G
OOMPolicy=stop

[Install]
WantedBy=default.target
