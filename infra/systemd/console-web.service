[Unit]
Description=Axon-X Console Web
After=network.target control-plane.service
Wants=network-online.target
Requires=control-plane.service

[Service]
Type=simple
EnvironmentFile=/etc/axon-watch/deployment.env
WorkingDirectory=/opt/axon-watch
ExecStart=/opt/axon-watch/scripts/ops/run-service.sh console-web
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
