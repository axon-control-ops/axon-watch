# Public shell
# Ports are fixed for the local dev stack. Startup fails fast on conflicts.
AXON_WATCH_PUBLIC_BASE_URL=http://127.0.0.1:4173
AXON_WATCH_CONSOLE_WEB_PORT=4173

# Services
AXON_WATCH_CONTROL_PLANE_PORT=8787
AXON_WATCH_WATCH_SERVICE_PORT=8788
AXON_WATCH_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8787
AXON_WATCH_WATCH_SERVICE_BASE_URL=http://127.0.0.1:8788

# Storage
AXON_WATCH_STATE_DIR=./.local/state
AXON_WATCH_CONTROL_PLANE_DB=./.local/state/control-plane.sqlite3
AXON_WATCH_WATCH_SERVICE_DB=./.local/state/axon-watch.sqlite3

# Delivery channel adapters (optional; enrolled for high/critical when set)
# AXON_WATCH_DELIVERY_WEBHOOK_URL=
# AXON_WATCH_MOBILE_PUSH_URL=
# AXON_WATCH_SLACK_WEBHOOK_URL=
# AXON_WATCH_DESKTOP_NOTIFY_PATH=
# AXON_WATCH_DELIVERY_RETRY_MAX=3

# KAIRO Azure speech (optional — prefer /vault secrets AZURE_SPEECH_KEY + AZURE_SPEECH_REGION)
# Process env overrides vault when both are set.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southafricanorth

# Deployment (local bootstrap defaults; see config/deployment.env.example)
AXON_WATCH_DEPLOYMENT_MODE=bootstrap
AXON_WATCH_BIND_HOST=127.0.0.1
# AXON_WATCH_CORS_ORIGINS=http://127.0.0.1:4173

# Runtime identity (bootstrap defaults for runtime summary assembly)
AXON_WATCH_PROVIDER_FAMILY=bootstrap
AXON_WATCH_PROVIDER_NAME="Axon-X Bootstrap"
AXON_WATCH_MODEL_NAME=bootstrap-model
AXON_WATCH_MODE_DEFAULT=agent
AXON_WATCH_TOOL_CALLING_SUPPORTED=false
AXON_WATCH_REASONING_SUPPORTED=false

# Auth placeholders
AXON_WATCH_AUTH_MODE=placeholder
AXON_WATCH_AUTH_ISSUER=
AXON_WATCH_AUTH_AUDIENCE=

# Optional email triage bridge to axon-local analysis (falls back to config/email-monitor-stub.json)
# AXON_WATCH_EMAIL_BRIDGE=1
# AXON_WATCH_EMAIL_BRIDGE_WORKSPACE_ID=7
# AXON_WATCH_EMAIL_STUB_FILE=config/email-monitor-stub.json
# AXON_WATCH_EMAIL_SETTINGS_FILE=config/email-operator-settings.json

# Online research (preferred → fallback). Copy real values into local gitignored .env
# or store in /vault as named secrets (unlock vault before research runs):
# 1) SearXNG (preferred local meta-search): ./scripts/dev/run-searxng.sh
#    Requires search.formats to include json in config/searxng/settings.yml
#    Docs: https://docs.searxng.org/dev/search_api.html
# AXON_WATCH_SEARXNG_URL=http://127.0.0.1:8080
# 2) Google Custom Search (legacy last-resort before DuckDuckGo Instant)
#    AXON_WATCH_GOOGLE_CSE_API_KEY / AXON_WATCH_GOOGLE_CSE_CX (password fields)
#    DashPro aliases: GOOGLE_SEARCH_API_KEY / GOOGLE_CSE_ID / EXPO_PUBLIC_GOOGLE_CSE_*.
#    Do not create a new Google search project for Axon-X; prefer SearXNG.
# AXON_WATCH_GOOGLE_CSE_API_KEY=
# AXON_WATCH_GOOGLE_CSE_CX=
# 3) Else DuckDuckGo Instant Answer API (often sparse)
# AXON_WATCH_RESEARCH_ENABLED=1
