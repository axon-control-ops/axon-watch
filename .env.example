# Public shell
# Ports are fixed for the local dev stack. Startup fails fast on conflicts.
AXON_WATCH_PUBLIC_BASE_URL=http://127.0.0.1:4173
AXON_WATCH_CONSOLE_WEB_PORT=4173

# Services
AXON_WATCH_CONTROL_PLANE_PORT=8787
AXON_WATCH_WATCH_SERVICE_PORT=8788
AXON_WATCH_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8787
AXON_WATCH_WATCH_SERVICE_BASE_URL=http://127.0.0.1:8788

# Storage
AXON_WATCH_STATE_DIR=./.local/state
AXON_WATCH_CONTROL_PLANE_DB=./.local/state/control-plane.sqlite3
AXON_WATCH_WATCH_SERVICE_DB=./.local/state/axon-watch.sqlite3

# Watch connector probe TTL (seconds). Summary/connectors/inbox reuse warm results.
# Set 0 to disable caching. refresh_summary always force-probes.
# AXON_WATCH_CONNECTOR_CACHE_TTL_SECONDS=15

# DashPro monitor probe TTL (seconds). Inbox/briefing reuse warm monitor snapshots.
# Set 0 to disable caching. refresh_summary and Sentry resolve clear the cache.
# AXON_WATCH_MONITOR_CACHE_TTL_SECONDS=15

# Start Cloudflare tunnel on watch service startup (after vault auto-unlock). Default on.
# Set 0/false/no/off to skip when tunnel auth or cloudflared is unavailable locally.
# AXON_WATCH_TUNNEL_AUTOSTART=1

# Continuous worker scheduler (role-tagged shifts). Default stale TTL is 720s.
# Hung employee-role executing runs are failed so the next shift can start.
# AXON_WATCH_WORKER_SCHEDULER=1
# AXON_WATCH_WORKER_SCHEDULER_DISPATCH=1
# AXON_WATCH_WORKER_SCHEDULER_INTERVAL_SECONDS=45
# AXON_WATCH_WORKER_RUN_STALE_SECONDS=720
# Terminal employee run retention (per workspace+role). Oldest completed/failed/cancelled
# role-tagged runs beyond this window are deleted on startup and each scheduler tick.
# AXON_WATCH_EMPLOYEE_RUN_RETENTION_PER_ROLE=8
# Abandoned operator review checkpoints (untagged review_ready) auto-complete after
# this idle TTL so briefing/runtime summary stay honest. Default 14400s (4h).
# AXON_WATCH_REVIEW_READY_STALE_SECONDS=14400

# CLI agent process isolation (systemd user scope). Wraps cursor-agent / jest / tsserver
# in transient scopes so systemd-oomd can kill an overweight agent without stopping the API.
# Disabled automatically when systemd-run or the user session bus is unavailable.
# AXON_WATCH_AGENT_SYSTEMD_SCOPE=1
# AXON_WATCH_AGENT_MEMORY_MAX=2G
# AXON_WATCH_AGENT_MEMORY_HIGH=1536M

# Delivery channel adapters (optional; enrolled for high/critical when set)
# AXON_WATCH_DELIVERY_WEBHOOK_URL=
# AXON_WATCH_MOBILE_PUSH_URL=
# AXON_WATCH_SLACK_WEBHOOK_URL=
# AXON_WATCH_DESKTOP_NOTIFY_PATH=
# AXON_WATCH_DELIVERY_RETRY_MAX=3

# KAIRO Azure speech (optional — prefer /vault secrets AZURE_SPEECH_KEY + AZURE_SPEECH_REGION)
# Process env overrides vault when both are set.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southafricanorth

# Deployment (local bootstrap defaults; see config/deployment.env.example)
AXON_WATCH_DEPLOYMENT_MODE=bootstrap
AXON_WATCH_BIND_HOST=127.0.0.1
# AXON_WATCH_CORS_ORIGINS=http://127.0.0.1:4173

# Runtime identity (bootstrap defaults for runtime summary assembly)
AXON_WATCH_PROVIDER_FAMILY=bootstrap
AXON_WATCH_PROVIDER_NAME="Axon-X Bootstrap"
AXON_WATCH_MODEL_NAME=bootstrap-model
AXON_WATCH_MODE_DEFAULT=agent
AXON_WATCH_TOOL_CALLING_SUPPORTED=false
AXON_WATCH_REASONING_SUPPORTED=false

# Auth (Gate 2) — mutating APIs
# off|placeholder: allow anonymous (local bootstrap / tests on loopback only)
# local_token: require Authorization: Bearer $AXON_WATCH_OPERATOR_TOKEN
# Remotely reachable deployments force local_token even if this is placeholder/off
# and disable loopback anonymous bypass.
# AXON_WATCH_AUTH_ALLOW_LOOPBACK=1 still permits 127.0.0.1 without a token (loopback only)
AXON_WATCH_AUTH_MODE=placeholder
AXON_WATCH_AUTH_ISSUER=
AXON_WATCH_AUTH_AUDIENCE=
# AXON_WATCH_OPERATOR_TOKEN=
# AXON_WATCH_AUTH_ALLOW_LOOPBACK=1
# AXON_WATCH_REMOTELY_REACHABLE=0
# Trusted always-on operator host only: allow vault auto-unlock even when the
# public URL is non-loopback. Does NOT disable local_token / origin / internal
# service-token containment.
# AXON_WATCH_ALLOW_VAULT_AUTO_UNLOCK=0
# Mutating API sliding-window limit per identity+client (0 disables)
# AXON_WATCH_MUTATING_RATE_LIMIT_PER_MINUTE=120
# Shared secret CP → watch for mutating /internal/watch/* (empty = allow local bootstrap only)
# Remotely reachable hosts REQUIRE this token (watch returns 503 if missing).
# AXON_WATCH_INTERNAL_SERVICE_TOKEN=
# Optional mTLS (proxy-verified client cert). Mint with: ./scripts/ops/mint-watch-mtls.sh
# AXON_WATCH_MTLS_REQUIRED=0
# AXON_WATCH_MTLS_CA_FILE=
# AXON_WATCH_MTLS_CLIENT_CERT=
# AXON_WATCH_MTLS_CLIENT_KEY=
# AXON_WATCH_MTLS_ALLOWED_CN=axon-control-plane

# Optional email triage bridge to axon-local analysis (falls back to config/email-monitor-stub.json)
# AXON_WATCH_EMAIL_BRIDGE=1
# AXON_WATCH_EMAIL_BRIDGE_WORKSPACE_ID=7
# AXON_WATCH_EMAIL_STUB_FILE=config/email-monitor-stub.json
# AXON_WATCH_EMAIL_SETTINGS_FILE=config/email-operator-settings.json

# Online research (preferred → fallback). Copy real values into local gitignored .env
# or store in /vault as named secrets (unlock vault before research runs):
# 1) SearXNG (preferred local meta-search): ./scripts/dev/run-searxng.sh
#    Requires search.formats to include json in config/searxng/settings.yml
#    Docs: https://docs.searxng.org/dev/search_api.html
# AXON_WATCH_SEARXNG_URL=http://127.0.0.1:8080
# 2) Google Custom Search (legacy last-resort before DuckDuckGo Instant)
#    AXON_WATCH_GOOGLE_CSE_API_KEY / AXON_WATCH_GOOGLE_CSE_CX (password fields)
#    DashPro aliases: GOOGLE_SEARCH_API_KEY / GOOGLE_CSE_ID / EXPO_PUBLIC_GOOGLE_CSE_*.
#    Do not create a new Google search project for Axon-X; prefer SearXNG.
# AXON_WATCH_GOOGLE_CSE_API_KEY=
# AXON_WATCH_GOOGLE_CSE_CX=
# 3) Else DuckDuckGo Instant Answer API (often sparse)
# AXON_WATCH_RESEARCH_ENABLED=1
