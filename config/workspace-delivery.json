{
  "schema_version": 1,
  "description": "Per-workspace automatic worker delivery (commit \u2192 push \u2192 draft PR \u2192 CI).",
  "defaults": {
    "enabled": true,
    "push_policy": "draft_pr",
    "attempt_budget": 3,
    "owner_role": "watcher",
    "escalate_role": "integrations",
    "lead_role": "lead",
    "ci_poll_timeout_seconds": 1800,
    "protected_branches": [
      "main",
      "master",
      "dev",
      "production",
      "release"
    ]
  },
  "workspaces": [
    {
      "workspace_id": "workspace_axon_watch",
      "enabled": true,
      "base_branch": "dev",
      "github_owner": "axon-control-ops",
      "github_repo": "axon-watch",
      "workflow_names": [
        "Axon-X Fast Gate"
      ],
      "attempt_budget": 3,
      "push_policy": "draft_pr"
    },
    {
      "workspace_id": "workspace_dashpro",
      "enabled": true,
      "base_branch": "development",
      "github_owner": "axon-control-ops",
      "github_repo": "dashpro",
      "workflow_names": [
        "CI",
        "Android CI/CD Pipeline",
        "Database SQL Linting",
        "Docs Policy Enforcement",
        "Security Scan"
      ],
      "attempt_budget": 3,
      "push_policy": "draft_pr",
      "notes": "Worker delivery opens draft PRs into development. Production web (Vercel) tracks main \u2014 merge development\u2192preview\u2192main only after CI green; production OTA/Play remain hard-gated."
    },
    {
      "workspace_id": "workspace_tps",
      "enabled": true,
      "base_branch": "master",
      "github_owner": "axon-control-ops",
      "github_repo": "tps",
      "workflow_names": [],
      "attempt_budget": 3,
      "push_policy": "draft_pr",
      "notes": "Worker delivery opens private draft PRs into master. TPS currently has no configured CI workflows; verification receipts remain mandatory before publication."
    }
  ]
}
