# Dedicated-server deployment environment (copy to /etc/axon-watch/deployment.env)
# Do not use loopback URLs for public-facing values on a dedicated host.

AXON_WATCH_DEPLOYMENT_MODE=dedicated
AXON_WATCH_REPO_ROOT=/opt/axon-watch
AXON_WATCH_BIND_HOST=127.0.0.1

# Public entrypoint (reverse proxy / TLS terminator)
AXON_WATCH_PUBLIC_BASE_URL=https://axon.example.com
AXON_WATCH_CONSOLE_WEB_PORT=4173

# Internal service URLs (private loopback or container network)
AXON_WATCH_CONTROL_PLANE_PORT=8787
AXON_WATCH_WATCH_SERVICE_PORT=8788
AXON_WATCH_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8787
AXON_WATCH_WATCH_SERVICE_BASE_URL=http://127.0.0.1:8788

# CORS: comma-separated browser origins allowed to call control-plane
AXON_WATCH_CORS_ORIGINS=https://axon.example.com

# Persistent storage (absolute paths on dedicated host)
AXON_WATCH_STATE_DIR=/var/lib/axon-watch/state
AXON_WATCH_CONTROL_PLANE_DB=/var/lib/axon-watch/state/control-plane.sqlite3
AXON_WATCH_WATCH_SERVICE_DB=/var/lib/axon-watch/state/axon-watch.sqlite3

# Runtime identity
AXON_WATCH_PROVIDER_FAMILY=production
AXON_WATCH_PROVIDER_NAME=Axon-X
AXON_WATCH_MODEL_NAME=axon-x-production
AXON_WATCH_MODE_DEFAULT=agent
AXON_WATCH_TOOL_CALLING_SUPPORTED=true
AXON_WATCH_REASONING_SUPPORTED=false

# Auth (configure before exposing publicly)
AXON_WATCH_AUTH_MODE=placeholder
AXON_WATCH_AUTH_ISSUER=
AXON_WATCH_AUTH_AUDIENCE=
