{
  "schema_version": 1,
  "enabled": true,
  "workspace_id": "workspace_dashpro",
  "workspace_label": "DashPro",
  "project_root": "/home/edp/Projectx/product/dashpro",
  "checks": [
    {
      "id": "dashpro_sentry_recent_issues",
      "type": "sentry_recent_issues",
      "service": "Sentry",
      "environment": "production"
    },
    {
      "id": "dashpro_posthog_recent_events",
      "type": "posthog_recent_events",
      "service": "PostHog",
      "limit": 1,
      "timeout_seconds": 35,
      "retries": 2
    },
    {
      "id": "dashpro_supabase_storage_quota",
      "type": "supabase_storage_quota",
      "service": "Supabase Storage"
    },
    {
      "id": "dashpro_marketing_site_health",
      "type": "http_health",
      "service": "EduDash Pro site",
      "url": "https://edudashpro.org.za",
      "expect_status": 200,
      "timeout_seconds": 8
    },
    {
      "id": "dashpro_github_api_health",
      "type": "http_health",
      "service": "GitHub API",
      "url": "https://api.github.com/zen",
      "expect_status": 200,
      "timeout_seconds": 5,
      "bearer_token_env": "GH_TOKEN"
    }
  ]
}
