{
  "schema_version": 2,
  "defaults": {
    "role": "lead",
    "name_template": "{display_name} Lead",
    "company_name_template": "{display_name}",
    "staffing_template": [
      { "role": "lead", "schedule": "on_demand" },
      { "role": "watcher", "schedule": "always_on" },
      { "role": "frontend", "schedule": "continuous" },
      { "role": "backend", "schedule": "continuous" },
      { "role": "integrations", "schedule": "continuous" }
    ]
  },
  "companies": {
    "workspace_axon_watch": {
      "company_name": "Axon-X",
      "employees": [
        {
          "name": "Axon-X Lead",
          "role": "lead",
          "owns": "priorities, handoffs, and product direction",
          "schedule": "on_demand",
          "primary": true
        },
        {
          "name": "Night Watch",
          "role": "watcher",
          "owns": "signals, connectors, and runtime health",
          "schedule": "always_on"
        },
        {
          "name": "Shell Craft",
          "role": "frontend",
          "owns": "console UI/UX, dock, and shell polish",
          "schedule": "continuous"
        },
        {
          "name": "Control Plane",
          "role": "backend",
          "owns": "APIs, runs, approvals, and persistence",
          "schedule": "continuous"
        },
        {
          "name": "Bridge",
          "role": "integrations",
          "owns": "connectors, watch service, and cross-repo wiring",
          "schedule": "continuous"
        }
      ]
    },
    "workspace_dashpro": {
      "company_name": "DashPro",
      "employees": [
        {
          "name": "DashPro Lead",
          "role": "lead",
          "owns": "DashPro product priorities, CI triage decisions, and handoffs",
          "schedule": "on_demand",
          "primary": true
        },
        {
          "name": "DashPro Night Watch",
          "role": "watcher",
          "owns": "DashPro signals, runtime health, and CI red-build alerts",
          "schedule": "always_on"
        },
        {
          "name": "DashPro Frontend",
          "role": "frontend",
          "owns": "DashPro UI/UX and Expo/Android app-config CI breaks",
          "schedule": "continuous"
        },
        {
          "name": "DashPro Backend",
          "role": "backend",
          "owns": "DashPro APIs, services, and quality-gate CI failures",
          "schedule": "continuous"
        },
        {
          "name": "DashPro Integrations",
          "role": "integrations",
          "owns": "DashPro connectors, GitHub Actions, runner/SDK/secrets CI wiring",
          "schedule": "continuous"
        }
      ]
    }
  },
  "agents": {
    "workspace_axon_local": {
      "agent_name": "Axon Local Lead",
      "role": "lead",
      "owns": "legacy axon-local reference and donor patterns",
      "schedule": "on_demand"
    }
  }
}
