# MoveIT operator environment template
# Copy to .env at project root (never commit .env).
# Keys match GET /api/workspaces/MoveIT/service-connection env_keys.

# GitHub — use GITHUB_TOKEN or GH_TOKEN (vault may supply GH_TOKEN)
GITHUB_TOKEN=
GH_TOKEN=

# Sentry
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_DSN=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_ACCESS_TOKEN=
